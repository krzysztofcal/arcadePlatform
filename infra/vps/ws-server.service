[Unit]
Description=ArcadePlatform WS Server
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=arcade
Group=arcade
WorkingDirectory=/opt/ws-server/current
ExecStart=/usr/bin/env node /opt/ws-server/current/server.mjs
Restart=always
RestartSec=2

Environment=NODE_ENV=production
Environment=PORT=3000
# EnvironmentFile=-/etc/arcadeplatform/ws-server.env

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ws-server

[Install]
WantedBy=multi-user.target

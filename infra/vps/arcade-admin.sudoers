# arcade-admin: reachable only with the vps-admin environment key after owner approval (#1159 root on demand).
# It may run only the fixed operation catalog of the root helper; the helper accepts exactly one numeric run id.
# No shell, interpreter, editor, package manager or free command is granted.
Cmnd_Alias ARCADE_ADMIN_COMMANDS = \
    /usr/local/sbin/arcade-vps-admin ledger-dispatchers-status *, \
    /usr/local/sbin/arcade-vps-admin npm-cache-1240-check *, \
    /usr/local/sbin/arcade-vps-admin npm-cache-1240-cleanup *, \
    /usr/local/sbin/arcade-vps-admin ledger-dispatchers-pause *, \
    /usr/local/sbin/arcade-vps-admin ledger-dispatchers-resume *, \
    /usr/local/sbin/arcade-vps-admin systemd-daemon-reload *, \
    /usr/local/sbin/arcade-vps-admin copilot-secret-snapshots-quarantine *, \
    /usr/local/sbin/arcade-vps-admin ledger-production-dispatcher-install *, \
    /usr/local/sbin/arcade-vps-admin ws-restart-gate-install *, \
    /usr/local/sbin/arcade-vps-admin github-app-token-prepare *, \
    /usr/local/sbin/arcade-vps-admin github-app-key-quarantine *, \
    /usr/local/sbin/arcade-vps-admin ws-preview-isolation-provision *, \
    /usr/local/sbin/arcade-vps-admin ws-preview-isolation-rollback *

arcade-admin ALL=(root) NOPASSWD: ARCADE_ADMIN_COMMANDS

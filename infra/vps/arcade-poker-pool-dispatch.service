[Unit]
Description=Dispatch the poker bot pool refill workflow with owner-configured mode (default dry-run)
After=network.target

[Service]
Type=oneshot
User=copilot
Environment=HOME=/home/copilot
Environment=GH_CONFIG_DIR=/home/copilot/.config/gh
Environment=PATH=/home/copilot/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=POKER_BOT_REFILL_MODE=dry-run
Environment=POKER_BOT_REFILL_TARGET=stage
# Optional root-owned configuration; installation never creates or activates it.
EnvironmentFile=-/etc/arcade/poker-pool-dispatch.env
ExecStart=/usr/local/bin/arcade-poker-pool-dispatch.sh
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

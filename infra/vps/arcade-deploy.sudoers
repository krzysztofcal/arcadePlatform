# Exact privileged operations for the copilot deployment account.
# Phase A is Preview-only. The deploy group owns only Preview application
# state; it does not grant access to secrets, systemd units, sudoers, shells or
# interpreters.
Cmnd_Alias ARCADE_DEPLOY_COMMANDS = \
    /usr/bin/systemctl restart ws-server-preview.service, \
    /usr/local/sbin/arcade-ws-preview-env-preflight ""

copilot ALL=(root) NOPASSWD: ARCADE_DEPLOY_COMMANDS

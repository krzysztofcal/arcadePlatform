NODE_ENV=production
HOST=127.0.0.1
PORT=3001
SUPABASE_URL=https://replace-with-stage-project-ref.supabase.co
SUPABASE_DB_URL=postgresql://replace-with-stage-db-user:replace-with-stage-db-password@replace-with-stage-db-host:5432/replace-with-stage-db-name
SUPABASE_SERVICE_ROLE_KEY=replace-with-stage-service-role-key
WS_AUTH_HS256_SECRET=replace-with-preview-hs256-secret
WS_AUTHORITATIVE_JOIN_ENABLED=1
SUPABASE_JWT_SECRET=replace-with-stage-jwt-secret
POKER_BOTS_ENABLED=0
SUPABASE_STAGE_PROJECT_REF=replace-with-stage-project-ref
POKER_WS_INTERNAL_TOKEN=replace-with-preview-internal-token
WS_POKER_BOT_ACTION_RETENTION_MS=0
WS_POKER_BOT_SETTLED_RETENTION_MS=0
WS_POKER_HUMAN_ACTION_RETENTION_MS=0
WS_POKER_HUMAN_SETTLED_RETENTION_MS=0
